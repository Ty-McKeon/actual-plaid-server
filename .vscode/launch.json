{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Flask (Debug)",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "bridge/app.py",
                "FLASK_DEBUG": "1",
                "PYTHONPATH": "${workspaceFolder}/bridge"
            },
            "args": [
                "run",
                "--no-debugger",
                "--no-reload",
                "--host=0.0.0.0",
                "--port=8080"
            ],
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "Python: Run app.py directly",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/bridge/app.py",
            "cwd": "${workspaceFolder}/bridge",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
