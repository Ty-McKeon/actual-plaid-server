{# Dashboard icons share a padded 24px grid and rounded strokes. #}
{% macro icon(name, classes='icon') -%}
<svg class="{{ classes }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {% if name == 'wallet' %}
        <path d="M20 8V6a2 2 0 0 0-2-2H6a3 3 0 0 0 0 6h14v9a2 2 0 0 1-2 2H6a3 3 0 0 1-3-3V7" />
        <path d="M20 13h-4a2 2 0 0 0 0 4h4" />
        <circle cx="16" cy="15" r=".5" fill="currentColor" stroke="none" />
    {% elif name == 'user' %}
        <circle cx="12" cy="8" r="3.5" />
        <path d="M5 20v-2a5 5 0 0 1 5-5h4a5 5 0 0 1 5 5v2" />
    {% elif name == 'bank' %}
        <path d="m3 9 9-5 9 5H3Z" />
        <path d="M5 12v6m7-6v6m7-6v6M3 21h18" />
    {% elif name == 'sync' %}
        <path d="M20 10a8 8 0 0 0-13.7-3.7L3 10m0-5v5h5" />
        <path d="M4 14a8 8 0 0 0 13.7 3.7L21 14m0 5v-5h-5" />
    {% elif name == 'refresh' %}
        <path d="M20 10a8 8 0 1 0 .2 5" />
        <path d="M20 4v6h-6" />
    {% elif name == 'key' %}
        <circle cx="8" cy="9" r="4.5" />
        <path d="m11.2 12.2 8.3 8.3H22v-3l-3-3h-2l-2-2" />
    {% elif name == 'copy' %}
        <rect x="8" y="8" width="12" height="13" rx="2" />
        <path d="M16 5V4a1 1 0 0 0-1-1H5a2 2 0 0 0-2 2v10a1 1 0 0 0 1 1h1" />
    {% elif name == 'card' %}
        <rect x="3" y="5" width="18" height="14" rx="2.5" />
        <path d="M3 10h18M7 15h3" />
    {% elif name == 'lock' %}
        <rect x="5" y="10" width="14" height="11" rx="2" />
        <path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3" />
    {% elif name == 'edit' %}
        <path d="m14 5 5 5M4 20l4.5-1L20 7.5a2.1 2.1 0 0 0-3-3L5.5 16 4 20Z" />
    {% elif name == 'trash' %}
        <path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v5m4-5v5" />
    {% elif name == 'check' %}
        <path d="m5 12 4.5 4.5L19 7" />
    {% elif name == 'info' %}
        <circle cx="12" cy="12" r="9" />
        <path d="M12 11v6" />
        <circle cx="12" cy="7.5" r=".75" fill="currentColor" stroke="none" />
    {% elif name == 'plus' %}
        <path d="M12 5v14M5 12h14" />
    {% endif %}
</svg>
{%- endmacro %}
