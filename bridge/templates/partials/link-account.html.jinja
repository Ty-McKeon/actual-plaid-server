{% from 'macros/icons.html.jinja' import icon %}
{# Plaid Link Account Action Component #}
<div class="card-header">
    <div class="card-title-group">
        <h2 class="card-title">
            {{ icon('bank', 'icon icon-title') }}
            Link Bank Account
        </h2>
        <p class="card-subtitle">Connect checking, savings, credit cards, or loans via Plaid</p>
    </div>
</div>

<div class="link-account-content">
    {% if not config or not config.plaid_client_id %}
        <div class="notice-box notice-warning">
            {{ icon('info', 'notice-icon') }}
            <div>
                <strong>Plaid Configuration Required</strong>
                <p>Please enter and verify your Plaid Client ID and Secret before linking a bank account.</p>
            </div>
        </div>
        <button id="link-btn" class="btn btn-primary" disabled title="Configure Plaid credentials first">
            {{ icon('plus', 'icon icon-sm') }}
            Link Bank Account
        </button>
    {% else %}
        <p class="link-description">
            Launch Plaid Link to securely authenticate with your financial institution. Access tokens are encrypted at rest.
        </p>
        <div class="link-action-wrap">
            <button id="link-btn" class="btn btn-primary btn-lg">
                {{ icon('plus', 'icon') }}
                <span id="link-btn-text">Link Bank Account</span>
                <span id="link-spinner" class="spinner" style="display: none;"></span>
            </button>
        </div>
    {% endif %}
    <button type="button" id="cancel-pending-link" class="btn btn-secondary" hidden>
        Cancel pending connection
    </button>
    <div id="link-status-message"></div>
</div>
