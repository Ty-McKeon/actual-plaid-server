{% from 'macros/icons.html.jinja' import icon %}
{# Linked Financial Institutions Component #}
<div class="card-header">
    <div class="card-title-group">
        <h2 class="card-title">
            {{ icon('card', 'icon icon-title') }}
            Connected Institutions
        </h2>
        <p class="card-subtitle">Financial institutions currently synced through this bridge</p>
    </div>
    <div class="header-actions">
        <span class="badge badge-neutral">
            {{ items|length if items else 0 }} Linked
        </span>
        <button
            type="button"
            class="btn btn-icon btn-sm"
            hx-get="{{ url_for('plaid.list_items') }}"
            hx-target="#connections-container"
            hx-swap="innerHTML"
            hx-indicator="#connections-spinner"
            title="Refresh connections"
        >
            {{ icon('refresh', 'icon icon-sm') }}
        </button>
        <span id="connections-spinner" class="htmx-indicator spinner"></span>
    </div>
</div>

{% if success %}
    <div class="alert alert-success" role="alert">
        {{ icon('check', 'alert-icon') }}
        <span>{{ success }}</span>
    </div>
{% endif %}

{% if items and items|length > 0 %}
    <div class="connections-grid">
        {% for item in items %}
            <div class="connection-card" id="connection-item-{{ item.id }}">
                <div class="connection-card-body">
                    <div class="institution-avatar">
                        {{ icon('bank', 'icon') }}
                    </div>
                    <div class="institution-info">
                        <h3 class="institution-name">{{ item.institution_name or item.institution_id or 'Financial Institution' }}</h3>
                        <div class="institution-meta">
                            {% if item.institution_id %}
                                <span class="badge badge-neutral badge-xs">{{ item.institution_id }}</span>
                            {% endif %}
                            <span class="code-font text-muted text-xs">ID: {{ item.item_id[:12] }}…</span>
                        </div>
                    </div>
                </div>

                <div class="connection-card-footer">
                    {# Asked of Plaid separately so a slow answer never delays the page #}
                    <span
                        class="status-indicator-badge"
                        hx-get="{{ url_for('plaid.item_status', item_id=item.id) }}"
                        hx-trigger="load"
                        hx-swap="innerHTML"
                    >
                        <span class="badge-dot badge-dot-muted"></span> <span class="text-muted">Checking…</span>
                    </span>
                    <div class="connection-card-actions">
                    <button
                        type="button"
                        class="btn btn-secondary btn-xs"
                        data-reconnect-item="{{ item.id }}"
                        data-institution-name="{{ item.institution_name or 'this institution' }}"
                        title="Sign in to this institution again without relinking its accounts"
                    >
                        {{ icon('refresh', 'icon icon-xs') }}
                        Reconnect
                    </button>
                    <button
                        type="button"
                        class="btn btn-outline-danger btn-xs"
                        hx-delete="{{ url_for('plaid.delete_item', item_id=item.id) }}"
                        hx-target="#connections-container"
                        hx-swap="innerHTML"
                        hx-confirm="Are you sure you want to disconnect {{ item.institution_name or 'this institution' }}?"
                    >
                        {{ icon('trash', 'icon icon-xs') }}
                        Disconnect
                    </button>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% else %}
    <div class="empty-state">
        <div class="empty-icon-wrap">
            {{ icon('card', 'empty-icon') }}
        </div>
        <h3 class="empty-title">No Institutions Connected</h3>
        <p class="empty-subtitle">Connect your bank account using Plaid Link above to start syncing balances and transactions to Actual Budget.</p>
    </div>
{% endif %}
