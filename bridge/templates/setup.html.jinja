<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Setup</title>
        <script>
            {% if port %}
                globalThis.serverPort = {{ port }};
            {% else %}
                globalThis.serverPort = 8080;
            {% endif %}
        </script>
        <script
            type="module"
            src="{{ url_for('static', filename='js/app.js') }}"
            defer
        ></script>
    </head>
    <body>
        <button id="link-button">Link Account</button>
    </body>
</html>
