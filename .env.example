# Cloudflare Tunnel token for the cloudflared container
CLOUDFLARE_TOKEN=your_cloudflare_tunnel_token_here

# URL Actual Budget uses to reach the bridge (embedded in SimpleFIN setup tokens)
BASE_URL=http://flask_bridge:8080

# Fernet key encrypting Plaid secrets and access tokens at rest. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing it makes the stored credentials undecryptable.
ENCRYPTION_KEY=

# Cloudflare Access team domain (e.g. myteam.cloudflareaccess.com) and the Application
# Audience (AUD) tag of the Access application protecting the dashboard. Both are
# required outside development mode.
CLOUDFLARE_TEAM_DOMAIN=
CLOUDFLARE_AUD=

# Optional: OpenID login for Actual Budget, required for multiple users. Leave blank to
# keep the single shared password. With Cloudflare Access as the provider, create a
# SaaS application of type OIDC with the redirect URL
# https://<actual hostname>/openid/callback, then copy its Issuer, Client ID and
# Client secret here. The hostname is the public URL of Actual, without a trailing slash.
ACTUAL_OPENID_DISCOVERY_URL=
ACTUAL_OPENID_CLIENT_ID=
ACTUAL_OPENID_CLIENT_SECRET=
ACTUAL_OPENID_SERVER_HOSTNAME=
