# Cloudflare Tunnel token for the cloudflared container
CLOUDFLARE_TOKEN=your_cloudflare_tunnel_token_here

# URL Actual Budget uses to reach the bridge (embedded in SimpleFIN setup tokens)
BASE_URL=http://flask_bridge:8080

# Fernet key encrypting Plaid secrets and access tokens at rest. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in development too. Losing or changing it makes stored credentials undecryptable.
ENCRYPTION_KEY=

# Cloudflare Access team domain (e.g. myteam.cloudflareaccess.com) and the Application
# Audience (AUD) tag of the Access application protecting the dashboard. Both are
# required outside development mode.
CLOUDFLARE_TEAM_DOMAIN=
CLOUDFLARE_AUD=

# Audience (AUD) tag of the Access application protecting the Actual Budget hostname.
# Leave blank if one Access application covers both the dashboard and Actual.
CLOUDFLARE_ACTUAL_AUD=

# Each user gets their own Actual Budget container, with their data kept in
# actual-data/users/<name>. By default you add users with scripts/actual-users.py
# and their containers run permanently.
#
# Uncomment to start the provisioner, which creates each container when its user
# visits and removes it after ACTUAL_IDLE_MINUTES without requests. It needs one
# service with access to the Docker socket (root on the host), so leave it off
# unless you need it. Run `scripts/actual-users.py sync` after changing this.
# COMPOSE_PROFILES=provisioner
#
# The next three settings only apply with the provisioner on. With self-service
# on, anyone the Access policy lets in gets a container on their first visit.
# Turn it off to serve only the users added with scripts/actual-users.py.
# ACTUAL_SELF_SERVICE=true
# ACTUAL_IDLE_MINUTES=30
# ACTUAL_MAX_CONTAINERS=10
#
# Limits for each user's container. A container that exceeds its memory limit is
# killed, so raise it if large imports or syncs fail. The provisioner, when
# enabled, logs a warning at startup if the host does not enforce a limit.
# ACTUAL_MEMORY_LIMIT_MB=512
# ACTUAL_CPU_LIMIT=1
# ACTUAL_PIDS_LIMIT=256
# Optional: replace with another tested official image digest, never a tag.
# ACTUAL_IMAGE=actualbudget/actual-server@sha256:24645e971da6bb1a1f953d6859e307a0b29be1e8b4130a35b3220c209b5b860c
